# Build output
build/
.gradle/
app/.cxx/
local.properties

# Signing material must never be committed. See README for how to generate
# your own key; the one used for the prebuilt APK in dist/ is throwaway.
*.jks
*.keystore
*.idsig

# Editors / OS
.idea/
*.iml
.DS_Store

# Baked assets: 61MB of generated output, reproducible with tools/bake.sh.
# The shipped APK in dist/ already contains them.
app/src/main/assets/*.pak
